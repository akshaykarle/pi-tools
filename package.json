{
  "name": "@akshaykarle/pi-tools",
  "version": "0.1.0",
  "description": "Pi coding agent extensions — security hardening, and more",
  "keywords": [
    "pi-package"
  ],
  "bundledDependencies": [
    "@plannotator/pi-extension"
  ],
  "pi": {
    "extensions": [
      "./extensions/security.ts",
      "./extensions/sandbox.ts",
      "./extensions/agent-teams.ts",
      "./extensions/git-worktree.ts",
      "node_modules/@plannotator/pi-extension"
    ],
    "skills": [
      "./skills",
      "node_modules/@plannotator/pi-extension/skills"
    ]
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "tui": "npx tsx scripts/team-tui.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": ">=0.66.1"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.49",
    "@plannotator/pi-extension": "^0.19.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "license": "MIT",
  "files": [
    "dist/",
    "extensions/",
    "skills/",
    "scripts/"
  ],
  "publishConfig": {
    "access": "public"
  }
}
